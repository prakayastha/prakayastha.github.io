Bootstrap: docker
From: ubuntu:22.04

# =============================================================================
# LAMMPS + ML packages container for UCL Young
#   - OpenMPI 4.1.1 with Omni-Path (PSM2) + SGE support, matching Young's
#     default module mpi/openmpi/4.1.1/gnu-4.9.2
#   - Compiled for Young's Xeon Gold 6248 (Cascade Lake) CPUs
#
# Build on any x86_64 Linux machine (NOT Apple Silicon / ARM):
#     sudo apptainer build lammps-young.sif lammps-young.def
#   or, without sudo but with fakeroot configured:
#     apptainer build --fakeroot lammps-young.sif lammps-young.def
#
# Copy to Young:
#     scp lammps-young.sif <user>@<young-login>:~/Scratch/containers/
# =============================================================================

%labels
    Description LAMMPS stable (ML-IAP, ML-SNAP, ML-PACE, Python) for UCL Young
    MPI OpenMPI-4.1.1-PSM2

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    OMPI_VERSION=4.1.1                   # must match the host module on Young
    ARCH_FLAGS="-O3 -march=cascadelake"  # Young's CPUs; don't use -march=native
    NPROC=$(nproc)

    # ---- System toolchain + Omni-Path libraries ----
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential gfortran cmake git wget ca-certificates pkg-config \
        python3 python3-dev python3-venv python3-pip \
        libfftw3-dev zlib1g-dev libnuma-dev \
        libpsm2-dev libfabric-dev
    rm -rf /var/lib/apt/lists/*

    # ---- OpenMPI 4.1.1 with PSM2 (Omni-Path) and SGE support ----
    cd /tmp
    wget -q https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-${OMPI_VERSION}.tar.gz
    tar xzf openmpi-${OMPI_VERSION}.tar.gz
    cd openmpi-${OMPI_VERSION}
    ./configure --prefix=/opt/openmpi \
        --with-psm2 \
        --with-ofi \
        --with-sge \
        --enable-shared
    make -j${NPROC}
    make install
    cd /tmp && rm -rf openmpi-${OMPI_VERSION}*

    export PATH=/opt/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:$LD_LIBRARY_PATH

    # ---- Python environment ----
    python3 -m venv /opt/venv
    . /opt/venv/bin/activate
    pip install --no-cache-dir --upgrade pip wheel setuptools
    pip install --no-cache-dir numpy scipy scikit-learn cython
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
    MPICC=/opt/openmpi/bin/mpicc pip install --no-cache-dir --no-binary=mpi4py mpi4py

    # ---- LAMMPS ----
    cd /opt
    git clone --depth 1 -b stable https://github.com/lammps/lammps.git
    mkdir -p /opt/lammps/build
    cd /opt/lammps/build

    cmake ../cmake \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_CXX_FLAGS="${ARCH_FLAGS}" \
        -D CMAKE_C_FLAGS="${ARCH_FLAGS}" \
        -D BUILD_MPI=ON \
        -D BUILD_OMP=ON \
        -D BUILD_SHARED_LIBS=ON \
        -D MPI_CXX_COMPILER=/opt/openmpi/bin/mpicxx \
        -D FFT=FFTW3 \
        -D PKG_ML-IAP=ON \
        -D PKG_ML-SNAP=ON \
        -D PKG_ML-PACE=ON \
        -D PKG_PYTHON=ON \
        -D MLIAP_ENABLE_PYTHON=ON \
        -D PKG_MANYBODY=ON \
        -D PKG_KSPACE=ON \
        -D PKG_MISC=ON \
        -D PKG_OPENMP=ON \
        -D Python_EXECUTABLE=/opt/venv/bin/python \
        -D CMAKE_INSTALL_PREFIX=/opt/lammps/install

    make -j${NPROC}
    make install
    make install-python

    # Keep the image smaller: drop the build tree (sources stay for reference)
    rm -rf /opt/lammps/build

    echo "LAMMPS build complete"

%environment
    export PATH=/opt/lammps/install/bin:/opt/openmpi/bin:/opt/venv/bin:$PATH
    export LD_LIBRARY_PATH=/opt/lammps/install/lib:/opt/openmpi/lib:$LD_LIBRARY_PATH
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%runscript
    exec lmp "$@"

%test
    # On a CPU without AVX-512, lmp will fail here with "illegal instruction".
    # That's expected when building on a non-Cascade-Lake machine; it will run on Young.
    if grep -q avx512f /proc/cpuinfo; then
        lmp -h | head -n 40
    else
        echo "Build host lacks AVX-512: skipping lmp test (run 'apptainer test' on Young)"
    fi
    ompi_info | grep -i -E "mtl: psm2|mtl: ofi" || echo "WARNING: no PSM2/OFI support in OpenMPI"
